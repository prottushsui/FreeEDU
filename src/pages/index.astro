---
import Base from '../layouts/Base.astro';
import { validateCatalog } from '../lib/catalog.ts';
const catalog = validateCatalog();
const published = catalog.materials.filter((material) => material.status === 'published');
---
<Base title="FreeEDU — Free Study Materials">
  <section class="hero"><h1>Free study materials for everyone.</h1><p>Browse validated subjects, topics, and content-addressed PDF downloads without accounts or tracking walls.</p><p><a class="button" href="/subjects">Browse subjects</a> <a class="button" href="/search">Search metadata</a></p></section>
  <h2>Featured materials</h2><div class="grid">{published.map((material) => <article class="card" data-pagefind-ignore><h3><a href={`/materials/${material.slug}`}>{material.title}</a></h3><p>{material.description}</p></article>)}</div>
</Base>
