---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSubjects, getPublishedMaterials } from '../lib/catalog';

const subjects = loadSubjects();
const recentMaterials = getPublishedMaterials().slice(0, 6);
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="container">
      <h1>Free Study Materials for Everyone</h1>
      <p class="hero-subtitle">Access high-quality educational resources across multiple subjects. All materials are free to download and use.</p>
      <div class="hero-actions">
        <a href="/subjects/" class="btn btn-primary">Browse Subjects</a>
        <a href="/search/" class="btn btn-secondary">Search Materials</a>
      </div>
    </div>
  </section>
  
  <section class="section">
    <div class="container">
      <h2>Browse by Subject</h2>
      {subjects.length === 0 ? (
        <div class="empty-state">
          <p>No subjects available yet.</p>
        </div>
      ) : (
        <div class="subject-grid">
          {subjects.map(subject => (
            <a href={`/subjects/${subject.slug}/`} class="subject-card">
              <h3>{subject.title}</h3>
              {subject.description && <p>{subject.description}</p>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  
  <section class="section section-alt">
    <div class="container">
      <h2>Recently Added</h2>
      {recentMaterials.length === 0 ? (
        <div class="empty-state">
          <p>No materials available yet.</p>
        </div>
      ) : (
        <div class="material-list">
          {recentMaterials.map(material => (
            <article class="material-card">
              <h3><a href={`/materials/${material.slug}/`}>{material.title}</a></h3>
              {material.description && <p>{material.description}</p>}
              {material.tags && material.tags.length > 0 && (
                <div class="tags">
                  {material.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
  
  <style>
    .hero {
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: white;
      padding: var(--spacing-2xl) 0;
      text-align: center;
    }
    
    .hero h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: var(--spacing-md);
    }
    
    .hero-subtitle {
      font-size: 1.125rem;
      opacity: 0.9;
      max-width: 600px;
      margin: 0 auto var(--spacing-xl);
    }
    
    .hero-actions {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      flex-wrap: wrap;
    }
    
    .btn {
      display: inline-block;
      padding: var(--spacing-md) var(--spacing-xl);
      border-radius: var(--radius-md);
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }
    
    .btn:hover {
      text-decoration: none;
      transform: translateY(-2px);
    }
    
    .btn-primary {
      background: white;
      color: var(--color-primary);
    }
    
    .btn-secondary {
      background: transparent;
      color: white;
      border: 2px solid white;
    }
    
    .section {
      padding: var(--spacing-2xl) 0;
    }
    
    .section-alt {
      background: var(--color-surface);
    }
    
    h2 {
      font-size: 1.75rem;
      margin-bottom: var(--spacing-lg);
    }
    
    .subject-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--spacing-lg);
    }
    
    .subject-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      transition: all 0.2s;
      text-decoration: none;
      color: var(--color-text);
    }
    
    .subject-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--color-primary);
      text-decoration: none;
    }
    
    .subject-card h3 {
      font-size: 1.25rem;
      margin-bottom: var(--spacing-sm);
      color: var(--color-primary);
    }
    
    .subject-card p {
      color: var(--color-muted);
      font-size: 0.875rem;
    }
    
    .material-list {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }
    
    .material-card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--spacing-lg);
    }
    
    .material-card h3 {
      margin-bottom: var(--spacing-sm);
    }
    
    .material-card h3 a {
      color: var(--color-text);
    }
    
    .material-card h3 a:hover {
      color: var(--color-primary);
    }
    
    .material-card p {
      color: var(--color-muted);
      margin-bottom: var(--spacing-sm);
    }
    
    .tags {
      display: flex;
      gap: var(--spacing-xs);
      flex-wrap: wrap;
    }
    
    .tag {
      background: var(--color-surface);
      color: var(--color-muted);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      font-weight: 500;
    }
    
    .empty-state {
      text-align: center;
      padding: var(--spacing-2xl);
      color: var(--color-muted);
    }
    
    @media (max-width: 640px) {
      .hero h1 {
        font-size: 1.75rem;
      }
      
      .hero-subtitle {
        font-size: 1rem;
      }
      
      .subject-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
