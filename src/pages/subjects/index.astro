---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSubjects, loadTopics, getMaterialsBySubject } from '../../lib/catalog';

const subjects = loadSubjects();
const topics = loadTopics();

// Count published materials per subject
function getMaterialCount(subjectId: string): number {
  const subjectTopics = topics.filter(t => t.subjectId === subjectId);
  const topicIds = subjectTopics.map(t => t.id);
  return getMaterialsBySubject(subjectId, subjectTopics).length;
}
---

<BaseLayout title="Subjects" description="Browse study materials by subject">
  <div class="container">
    <h1>Browse Subjects</h1>
    <p class="page-intro">Select a subject to explore available study materials.</p>
    
    {subjects.length === 0 ? (
      <div class="empty-state">
        <h2>No subjects yet</h2>
        <p>Study materials will appear here once they are added.</p>
      </div>
    ) : (
      <div class="subject-list">
        {subjects.map(subject => (
          <article class="subject-item">
            <div class="subject-header">
              <h2><a href={`/subjects/${subject.slug}/`}>{subject.title}</a></h2>
              <span class="material-count">{getMaterialCount(subject.id)} material{getMaterialCount(subject.id) !== 1 ? 's' : ''}</span>
            </div>
            {subject.description && <p class="subject-description">{subject.description}</p>}
            <a href={`/subjects/${subject.slug}/`} class="view-link">View subject →</a>
          </article>
        ))}
      </div>
    )}
  </div>
  
  <style>
    .container h1 {
      font-size: 2rem;
      margin-bottom: var(--spacing-md);
    }
    
    .page-intro {
      color: var(--color-muted);
      margin-bottom: var(--spacing-xl);
      font-size: 1.125rem;
    }
    
    .subject-list {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }
    
    .subject-item {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg);
      transition: all 0.2s;
    }
    
    .subject-item:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--color-primary);
    }
    
    .subject-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: var(--spacing-sm);
      flex-wrap: wrap;
      gap: var(--spacing-sm);
    }
    
    .subject-header h2 {
      font-size: 1.5rem;
      margin: 0;
    }
    
    .subject-header h2 a {
      color: var(--color-text);
    }
    
    .subject-header h2 a:hover {
      color: var(--color-primary);
    }
    
    .material-count {
      background: var(--color-surface);
      color: var(--color-muted);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      font-weight: 500;
    }
    
    .subject-description {
      color: var(--color-muted);
      margin-bottom: var(--spacing-md);
    }
    
    .view-link {
      color: var(--color-primary);
      font-weight: 600;
      text-decoration: none;
    }
    
    .view-link:hover {
      text-decoration: underline;
    }
    
    .empty-state {
      text-align: center;
      padding: var(--spacing-2xl);
      background: var(--color-surface);
      border-radius: var(--radius-lg);
    }
    
    .empty-state h2 {
      margin-bottom: var(--spacing-sm);
    }
    
    .empty-state p {
      color: var(--color-muted);
    }
  </style>
</BaseLayout>
