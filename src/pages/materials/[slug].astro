---
import Base from '../../layouts/Base.astro';import { validateCatalog, assetUrl } from '../../lib/catalog.js';export function getStaticPaths(){const c=validateCatalog();return c.materials.filter(m=>m.status==='published').map(m=>({params:{slug:m.slug},props:{m,c,a:c.assets.find(a=>a.id===m.assetId)}}))}const {m,c,a}=Astro.props;const subject=c.subjects.find(s=>s.id===m.subjectId);const topics=c.topics.filter(t=>m.topicIds.includes(t.id));
---
<Base title={`${m.title} — FreeEDU`} description={m.description}><article class="card" data-pagefind-body data-pagefind-meta={`title:${m.title},description:${m.description},subject:${subject.name},topics:${topics.map(t=>t.title).join(' ')},tags:${m.tags.join(' ')},file type:${m.fileType}`}><p class="meta"><a href={`/subjects/${subject.slug}`}>{subject.name}</a> · {topics.map(t=><a href={`/topics/${t.slug}/page/1`}>{t.title} </a>)}</p><h1>{m.title}</h1><p>{m.description}</p><p class="tags">{m.tags.map(tag=><span>{tag}</span>)}</p><a class="button" href={assetUrl(a)} download>Download PDF</a></article></Base>
