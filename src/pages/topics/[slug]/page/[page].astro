---
import Base from '../../../../layouts/Base.astro';import { validateCatalog } from '../../../../lib/catalog.js';const PER=6;export function getStaticPaths(){const c=validateCatalog();return c.topics.flatMap(t=>{const mats=c.materials.filter(m=>m.status==='published'&&m.topicIds.includes(t.id));const pages=Math.max(1,Math.ceil(mats.length/PER));return Array.from({length:pages},(_,i)=>({params:{slug:t.slug,page:String(i+1)},props:{t,c,page:i+1}}))})}const {t,c,page}=Astro.props;const mats=c.materials.filter(m=>m.status==='published'&&m.topicIds.includes(t.id));const slice=mats.slice((page-1)*PER,page*PER);
---
<Base title={`${t.title} materials — FreeEDU`} description={t.description}><h1>{t.title}</h1><p>{t.description}</p>{slice.length?<div class="grid">{slice.map(m=><article class="card"><h2><a href={`/materials/${m.slug}`}>{m.title}</a></h2><p>{m.description}</p></article>)}</div>:<p class="empty">No published materials are available for this topic yet.</p>}<p>{page>1&&<a href={`/topics/${t.slug}/page/${page-1}`}>Previous</a>} {mats.length>page*PER&&<a href={`/topics/${t.slug}/page/${page+1}`}>Next</a>}</p></Base>
