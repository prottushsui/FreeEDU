---
import Base from '../../../layouts/Base.astro';
import { validateCatalog } from '../../../lib/catalog.ts';
const PER_PAGE = 6;
export function getStaticPaths() {
  const catalog = validateCatalog();
  return catalog.topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic, catalog } }));
}
const { topic, catalog } = Astro.props;
const materials = catalog.materials.filter((material) => material.status === 'published' && material.topicIds.includes(topic.id));
const firstPage = materials.slice(0, PER_PAGE);
---
<Base title={`${topic.title} materials — FreeEDU`} description={topic.description}>
  <article>
    <h1>{topic.title}</h1>
    <p>{topic.description}</p>
    {firstPage.length ? <div class="grid">{firstPage.map((material) => <article class="card"><h2><a href={`/materials/${material.slug}`}>{material.title}</a></h2><p>{material.description}</p></article>)}</div> : <p class="empty">No published materials are available for this topic yet.</p>}
    {materials.length > PER_PAGE && <p><a href={`/topics/${topic.slug}/page/2`}>Next page</a></p>}
    <p><a href={`/topics/${topic.slug}/page/1`}>Open the paginated listing</a></p>
  </article>
</Base>
